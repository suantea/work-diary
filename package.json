{
  "name": "work-report-assistant",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "asuan 工作助手 - 工作记录与日报生成工具",
  "author": "asuan",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node generate-icons.js && vite",
    "build": "node generate-icons.js && vite build",
    "pack": "node generate-icons.js && vite build && npx @electron/rebuild -f -w better-sqlite3 && electron-builder --win --dir",
    "dist": "node generate-icons.js && vite build && npx @electron/rebuild -f -w better-sqlite3 && electron-builder --win",
    "generate-icons": "node generate-icons.js",
    "typecheck": "vue-tsc --noEmit"
  },
  "build": {
    "appId": "com.work-report.assistant",
    "productName": "asuan 工作助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icons/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/screenshot-desktop/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/marked/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "asuan 工作助手",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/screenshot-desktop/**/*",
      "tesseract/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-store": "^8.2.0",
    "iconv-lite": "^0.7.2",
    "marked": "^18.0.4",
    "screenshot-desktop": "^1.15.4",
    "vue": "^3.5.0",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@graduenz/mcp-sqlite-server": "^1.1.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@playwright/mcp": "^0.0.77",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.0"
  }
}
